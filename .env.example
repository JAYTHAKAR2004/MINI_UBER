# Application
APP_NAME=Zomato
APP_ENV=development
DEBUG=true

# PostgreSQL
POSTGRES_DB=eta_db
POSTGRES_USER=eta_user
POSTGRES_PASSWORD=2004
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ORDER_TOPIC=order_events
KAFKA_LOCATION_TOPIC=location_events

# API
API_HOST=0.0.0.0
API_PORT=8000

# Razorpay Test Mode (Optional - never expose RAZORPAY_KEY_SECRET in frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# YouPI-PG Self-Hosted UPI Gateway (MANUAL_UPI default; keep secrets server-side only)
YOUPI_API_URL=http://localhost:6100
YOUPI_CHECKOUT_URL=http://localhost:7000
YOUPI_MERCHANT_ID=
YOUPI_MERCHANT_API_KEY=
YOUPI_WEBHOOK_SECRET=
YOUPI_UPI_METHOD=MANUAL_UPI
YOUPI_WEBHOOK_TOLERANCE_SECONDS=300
YOUPI_RECONCILE_ADMIN_TOKEN=

# Fault Tolerance Configuration (P9)
LOG_LEVEL=INFO
REDIS_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=1.0
REDIS_RETRY_MAX_ATTEMPTS=3
REDIS_RETRY_INITIAL_BACKOFF=1.0
REDIS_CIRCUIT_FAILURE_THRESHOLD=3
REDIS_CIRCUIT_RECOVERY_TIMEOUT=5
REDIS_CIRCUIT_HALF_OPEN_REQUESTS=1
KAFKA_MESSAGE_TIMEOUT_MS=5000
KAFKA_FLUSH_TIMEOUT=5.0
KAFKA_RETRY_MAX_ATTEMPTS=3
KAFKA_RETRY_INITIAL_BACKOFF=1.0
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_INITIAL_BACKOFF=1.0
HTTP_CLIENT_TIMEOUT=8.0
